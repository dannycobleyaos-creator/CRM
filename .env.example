# ---------------------------------------------------------------------------
# Hygge Pergola CRM — environment
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Database. SQLite is used out of the box so the portal runs anywhere with no
# extra services. Swap the provider in prisma/schema.prisma to move to Postgres.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public app URL (used for absolute links in emails/notifications later).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
